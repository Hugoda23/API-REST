# Copiar a .env.production en el VPS y cambiar los valores.
APP_NAME=API-REST
APP_URL=https://API_DOMINIO
# Generar con: docker compose -f docker-compose.prod.yml run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=
APP_LOCALE=es

DB_DATABASE=api_rest
DB_USERNAME=api_rest
DB_PASSWORD=cambia-esta-clave

# Clave que deben mandar POST/PUT/PATCH/DELETE en la cabecera X-API-Key.
# Generar con: openssl rand -hex 24
API_KEY=cambia-esta-clave-tambien

PROXY_NETWORK=sga_sga_network
